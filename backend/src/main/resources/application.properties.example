spring.application.name=CampusAsk

# 数据库配置（填写你自己的MySQL信息）
spring.datasource.url=jdbc:mysql://localhost:3306/campusask?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=你的数据库密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis配置
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.configuration.map-underscore-to-camel-case=true

# 端口
server.port=8080

# DeepSeek API Key（去 https://platform.deepseek.com 注册获取）
deepseek.api.key=你的API Key
