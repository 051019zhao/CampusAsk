<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.campusask.campusask.mapper.ForumLikeMapper">

    <insert id="insert" parameterType="com.campusask.campusask.entity.ForumLike">
        INSERT INTO forum_like (post_id, user_id)
        VALUES (#{postId}, #{userId})
    </insert>

    <delete id="delete">
        DELETE FROM forum_like WHERE post_id = #{postId} AND user_id = #{userId}
    </delete>

    <select id="selectByPostAndUser" resultType="com.campusask.campusask.entity.ForumLike">
        SELECT * FROM forum_like WHERE post_id = #{postId} AND user_id = #{userId}
    </select>

    <select id="selectLikedPostIdsByUser" resultType="long">
        SELECT post_id FROM forum_like WHERE user_id = #{userId}
    </select>

    <select id="countByPostId" resultType="int">
        SELECT COUNT(*) FROM forum_like WHERE post_id = #{postId}
    </select>

</mapper>
