<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.campusask.campusask.mapper.SensitiveWordMapper">

    <select id="findAllSensitiveWords" resultType="com.campusask.campusask.entity.SensitiveWord">
        SELECT id, word
        FROM sensitive_word
        ORDER BY id ASC
    </select>

</mapper>
